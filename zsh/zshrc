# ── Homebrew ───────────────────────────────────────────────────────
# Sets PATH, HOMEBREW_PREFIX, MANPATH etc. (replaces the manual PATH line)
# macOS: /opt/homebrew. Linux: Linuxbrew if present, otherwise none.
for _brew in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x $_brew ]] && { eval "$($_brew shellenv)"; break }
done
unset _brew

# Find a plugin script under Homebrew or the distro's /usr/share
_zsh_plugin() {
  local f
  for f in "$HOMEBREW_PREFIX/share/$1/$1.zsh" "/usr/share/$1/$1.zsh"; do
    [[ -r $f ]] && { source "$f"; return }
  done
}

# ── History ────────────────────────────────────────────────────────
ZSH_CONFIG_DIR="$HOME/.config/zsh"   # ~/.zshrc is a symlink to $ZSH_CONFIG_DIR/zshrc
HISTFILE="$ZSH_CONFIG_DIR/history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY          # share history across Ghostty tabs/windows
setopt EXTENDED_HISTORY       # store timestamps
setopt HIST_IGNORE_ALL_DUPS   # drop older duplicate entries
setopt HIST_IGNORE_SPACE      # commands starting with a space aren't saved
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY            # !! expansions are shown before running

# ── Behaviour ──────────────────────────────────────────────────────
setopt AUTO_CD                # type a directory name to cd into it
setopt INTERACTIVE_COMMENTS   # allow # comments at the prompt
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT   # `cd -<TAB>` for recent dirs

# ── Completion ─────────────────────────────────────────────────────
# Homebrew-installed completions (git, brew, etc.)
[[ -n $HOMEBREW_PREFIX ]] && fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# Only rebuild the completion cache once a day (faster startup)
_zcompdump="$ZSH_CONFIG_DIR/zcompdump"
if [[ -n $_zcompdump(#qN.mh+24) || ! -f $_zcompdump ]]; then
  compinit -d "$_zcompdump"
else
  compinit -C -d "$_zcompdump"
fi
unset _zcompdump
zstyle ':completion:*' menu select                          # arrow-key menu
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# PYENV
# eval "$(pyenv init -)"
# if which pyenv-virtualenv-init > /dev/null; then eval "$(pyenv virtualenv-init -)"; fi

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
if [ -x /opt/miniconda3/bin/conda ]; then   # only on machines that have it
# Shells started by tmux inherit conda's variables, but macOS path_helper
# (/etc/zprofile) has reordered PATH, so `conda activate` thinks the env is
# already active and leaves /usr/bin first. Start from a clean slate.
unset CONDA_SHLVL CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER ${(M)${(k)parameters}:#CONDA_PREFIX_<->}
path=(${path:#/opt/miniconda3/*})
__conda_setup="$('/opt/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
conda activate research
fi
# <<< conda initialize <<<

# Linux machine: python venv instead of conda
[ -f ~/pyenv/research/bin/activate ] && source ~/pyenv/research/bin/activate

export PATH="$HOME/.local/bin:$PATH"

# ── ls: make folders vs files obvious ──────────────────────────────
# -F appends a type marker: / = dir, * = executable, @ = symlink
# -G / CLICOLOR colorises: dirs bold cyan, symlinks bold magenta,
#   executables bold red (readable on Catppuccin Macchiato).
if [[ $OSTYPE == darwin* ]]; then   # BSD ls
  export CLICOLOR=1
  export LSCOLORS='GxFxCxDxBxegedabagacad'
  alias ls='ls -FG'
  alias ll='ls -lhFG -D "%d %b %Y %H:%M"'
  alias la='ls -lAhFG -D "%d %b %Y %H:%M"'
  alias l='ls -CFG'
else                               # GNU ls: same colours via LS_COLORS
  export LS_COLORS='di=1;36:ln=1;35:so=1;32:pi=1;33:ex=1;31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43'
  alias ls='ls -F --color=auto'
  alias ll='ls -lhF --color=auto --time-style="+%d %b %Y %H:%M"'
  alias la='ls -lAhF --color=auto --time-style="+%d %b %Y %H:%M"'
  alias l='ls -CF --color=auto'
fi

# Colour for grep
alias grep='grep --color=auto'
alias vim=nvim

alias ..='cd ..'
alias ...='cd ../..'

# Homebrew GCC instead of Apple's clang shims: newest gcc-N installed
if [[ $OSTYPE == darwin* && -n $HOMEBREW_PREFIX ]]; then
  _gcc=($HOMEBREW_PREFIX/bin/gcc-<->(Nn))
  if (( $#_gcc )); then
    alias gcc=$_gcc[-1]
    alias g++=${_gcc[-1]/gcc-/g++-}
  fi
  unset _gcc
fi

# Machine-specific settings (servers, keys): untracked, since this repo is public
[[ -r $ZSH_CONFIG_DIR/local.zsh ]] && source "$ZSH_CONFIG_DIR/local.zsh"

# ── Key bindings ───────────────────────────────────────────────────
bindkey -e                                  # emacs-style line editing
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search  # ↑ searches history by prefix
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[f' forward-word                  # Option-→ / Option-← word jumps
bindkey '^[b' backward-word

# ── fzf: Ctrl-R history, Ctrl-T files, Alt-C cd ───────────────────
# Catppuccin Macchiato colours to match Ghostty
export FZF_DEFAULT_OPTS=" \
--height=40% --layout=reverse --border \
--color=bg+:#363a4f,spinner:#f4dbd6,hl:#ed8796 \
--color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6 \
--color=marker:#b7bdf8,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796 \
--color=selected-bg:#494d64"
(( $+commands[fzf] )) && source <(fzf --zsh)

# ── zoxide: `z <partial-name>` to jump to directories ─────────────
#eval "$(zoxide init zsh)"

# ── Autosuggestions (→ to accept) ─────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6e738d'   # visible on Catppuccin
# Like the built-in `history` strategy, but skips history entries that refer
# to files/dirs that don't exist in the current directory.
_zsh_autosuggest_strategy_history_existing() {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local prefix="${1//(#m)[\\*?[\]<>()|^~#]/\\$MATCH}"
  local key entry w cmd ok
  local -a words
  for key in ${(On)${(k)history[(R)$prefix*]}}; do
    entry=$history[$key]
    words=(${(z)entry})
    cmd=${(Q)words[1]}
    ok=1
    for w in ${words[2,-1]}; do
      w=${(Q)w}
      [[ $w == (-*|*://*|*=*|\;|\&\&|\|\||\|) ]] && continue
      w=${w/#\~/$HOME}
      if [[ $cmd == (cd|pushd) || $w == */* || $w == [^.]##.[A-Za-z0-9]## ]]; then
        [[ -e $w ]] || { ok=0; break }
      fi
    done
    (( ok )) && { typeset -g suggestion=$entry; return }
  done
}
ZSH_AUTOSUGGEST_STRATEGY=(history_existing completion)
_zsh_plugin zsh-autosuggestions

# ── Prompt: Starship (config in ~/.config/starship.toml) ─────────
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ── Syntax highlighting — must stay last ──────────────────────────
_zsh_plugin zsh-syntax-highlighting
unfunction _zsh_plugin
